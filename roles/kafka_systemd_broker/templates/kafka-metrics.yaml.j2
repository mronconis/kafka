lowercaseOutputName: true

rules:
# -------------------------------------------------------------
# 1. KRAFT CONTROLLER & METADATA LOADER (YAMMER STYLE)
# -------------------------------------------------------------

# KRaft Controller Metrics (ActiveController, Broker attivi, etc.)
- pattern: kafka.controller<type=KafkaController, name=(.+)><>Value
  name: kafka_controller_kafkacontroller_$1
  type: GAUGE

# Metadata Loader Metrics
- pattern: kafka.server<type=MetadataLoader, name=(.+)><>Value
  name: kafka_server_metadataloader_$1
  type: GAUGE

# Controller Event Manager Metrics
- pattern: kafka.controller<type=ControllerEventManager, name=(.+)><>Value
  name: kafka_controller_controllereventmanager_$1
  type: GAUGE

# Controller Stats Rates (Per catturare MeanRate, OneMinuteRate di LeaderElection, ecc.)
- pattern: kafka.controller<type=ControllerStats, name=(.+)><>(MeanRate|OneMinuteRate|FiveMinuteRate|FifteenMinuteRate)
  name: kafka_controller_controllerstats_$1_$2
  type: GAUGE

# -------------------------------------------------------------
# 2. KRAFT RAFT & BROKER METADATA (KAFKA METRICS STYLE)
# -------------------------------------------------------------

# Broker Metadata Metrics
- pattern: "kafka.server<type=broker-metadata-metrics><>([^:]+)"
  name: kafka_server_brokermetadatametrics_$1
  type: GAUGE

# Core RAFT Protocol Metrics (Con client-id esposto)
- pattern: "kafka.server<type=raft-metrics, client-id=(.+)><>(.+-total|.+-max)"
  name: kafka_server_raftmetrics_$2
  type: COUNTER
  labels:
    client_id: "$1"

- pattern: "kafka.server<type=raft-metrics, client-id=(.+)><>([^:]+)"
  name: kafka_server_raftmetrics_$2
  type: GAUGE
  labels:
    client_id: "$1"

# Core RAFT Channel Metrics (Con client-id esposto)
- pattern: "kafka.server<type=raft-channel-metrics, client-id=(.+)><>(.+-total|.+-max)"
  name: kafka_server_raftchannelmetrics_$2
  type: COUNTER
  labels:
    client_id: "$1"

- pattern: "kafka.server<type=raft-channel-metrics, client-id=(.+)><>([^:]+)"
  name: kafka_server_raftchannelmetrics_$2
  type: GAUGE
  labels:
    client_id: "$1"

# -------------------------------------------------------------
# 3. KAFKA 4.x NEW COORDINATORS (KAFKA METRICS STYLE)
# -------------------------------------------------------------

# New Group Coordinator Metrics (Kafka 4.x / KIP-848)
- pattern: "kafka.server<type=group-coordinator-metrics><>(.+-total|.+-max)"
  name: kafka_server_groupcoordinator_$1
  type: COUNTER

- pattern: "kafka.server<type=group-coordinator-metrics><>([^:]+)"
  name: kafka_server_groupcoordinator_$1
  type: GAUGE

# Share Coordinator Metrics (KIP-932 Share Groups)
- pattern: "kafka.server<type=share-coordinator-metrics><>(.+-total|.+-max)"
  name: kafka_server_sharecoordinator_$1
  type: COUNTER

- pattern: "kafka.server<type=share-coordinator-metrics><>([^:]+)"
  name: kafka_server_sharecoordinator_$1
  type: GAUGE

# -------------------------------------------------------------
# 4. NETWORK & REQUEST METRICS RULES (YAMMER)
# -------------------------------------------------------------

- pattern: kafka.network<type=RequestMetrics, name=(.+), request=(.+)><>Count
  name: kafka_network_requestmetrics_$1_total
  type: COUNTER
  labels:
    request: "$2"

- pattern: kafka.network<type=RequestMetrics, name=(.+), request=(.+)><>99thPercentile
  name: kafka_network_requestmetrics_$1_99th_percentile
  type: GAUGE
  labels:
    request: "$2"

# -------------------------------------------------------------
# 5. CATCH-ALL RULES (YAMMER STYLE LEGACY)
# -------------------------------------------------------------

# Special cases and very specific rules
- pattern : kafka.server<type=(.+), name=(.+), clientId=(.+), topic=(.+), partition=(.*)><>Value
  name: kafka_server_$1_$2
  type: GAUGE
  labels:
    clientId: "$3"
    topic: "$4"
    partition: "$5"
- pattern : kafka.server<type=(.+), name=(.+), clientId=(.+), brokerHost=(.+), brokerPort=(.+)><>Value
  name: kafka_server_$1_$2
  type: GAUGE
  labels:
    clientId: "$3"
    broker: "$4:$5"
- pattern : kafka.coordinator.(\w+)<type=(.+), name=(.+)><>Value
  name: kafka_coordinator_$1_$2_$3
  type: GAUGE

# Generic per-second counters with 0-2 key/value pairs
- pattern: kafka.(\w+)<type=(.+), name=(.+)PerSec\w*, (.+)=(.+), (.+)=(.+)><>Count
  name: kafka_$1_$2_$3_total
  type: COUNTER
  labels:
    "$4": "$5"
    "$6": "$7"
- pattern: kafka.(\w+)<type=(.+), name=(.+)PerSec\w*, (.+)=(.+)><>Count
  name: kafka_$1_$2_$3_total
  type: COUNTER
  labels:
    "$4": "$5"
- pattern: kafka.(\w+)<type=(.+), name=(.+)PerSec\w*><>Count
  name: kafka_$1_$2_$3_total
  type: COUNTER

# Quota specific rules
- pattern: kafka.server<type=(.+), user=(.+), client-id=(.+)><>([a-z-]+)
  name: kafka_server_quota_$4
  type: GAUGE
  labels:
    resource: "$1"
    user: "$2"
    clientId: "$3"
- pattern: kafka.server<type=(.+), client-id=(.+)><>([a-z-]+)
  name: kafka_server_quota_$3
  type: GAUGE
  labels:
    resource: "$1"
    clientId: "$2"
- pattern: kafka.server<type=(.+), user=(.+)><>([a-z-]+)
  name: kafka_server_quota_$3
  type: GAUGE
  labels:
    resource: "$1"
    user: "$2"

# Generic gauges with 0-2 key/value pairs
- pattern: kafka.(\w+)<type=(.+), name=(.+), (.+)=(.+), (.+)=(.+)><>Value
  name: kafka_$1_$2_$3
  type: GAUGE
  labels:
    "$4": "$5"
    "$6": "$7"
- pattern: kafka.(\w+)<type=(.+), name=(.+), (.+)=(.+)><>Value
  name: kafka_$1_$2_$3
  type: GAUGE
  labels:
    "$4": "$5"
- pattern: kafka.(\w+)<type=(.+), name=(.+)><>Value
  name: kafka_$1_$2_$3
  type: GAUGE

# Emulate Prometheus 'Summary' metrics for the exported 'Histogram's
- pattern: kafka.(\w+)<type=(.+), name=(.+), (.+)=(.+), (.+)=(.+)><>Count
  name: kafka_$1_$2_$3_count
  type: COUNTER
  labels:
    "$4": "$5"
    "$6": "$7"
- pattern: kafka.(\w+)<type=(.+), name=(.+), (.+)=(.*), (.+)=(.+)><>(\d+)thPercentile
  name: kafka_$1_$2_$3
  type: GAUGE
  labels:
    "$4": "$5"
    "$6": "$7"
    quantile: "0.$8"
- pattern: kafka.(\w+)<type=(.+), name=(.+), (.+)=(.+)><>Count
  name: kafka_$1_$2_$3_count
  type: COUNTER
  labels:
    "$4": "$5"
- pattern: kafka.(\w+)<type=(.+), name=(.+), (.+)=(.*)><>(\d+)thPercentile
  name: kafka_$1_$2_$3
  type: GAUGE
  labels:
    "$4": "$5"
    quantile: "0.$6"
- pattern: kafka.(\w+)<type=(.+), name=(.+)><>Count
  name: kafka_$1_$2_$3_count
  type: COUNTER
- pattern: kafka.(\w+)<type=(.+), name=(.+)><>(\d+)thPercentile
  name: kafka_$1_$2_$3
  type: GAUGE
  labels:
    quantile: "0.$4"

# Generic gauges for MeanRate Percent
- pattern: kafka.(\w+)<type=(.+), name=(.+)Percent\w*><>MeanRate
  name: kafka_$1_$2_$3_percent
  type: GAUGE
- pattern: kafka.(\w+)<type=(.+), name=(.+)Percent\w*><>Value
  name: kafka_$1_$2_$3_percent
  type: GAUGE
- pattern: kafka.(\w+)<type=(.+), name=(.+)Percent\w*, (.+)=(.+)><>Value
  name: kafka_$1_$2_$3_percent
  type: GAUGE
  labels:
    "$4": "$5"